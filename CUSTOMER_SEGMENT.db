SELECT * 
FROM CUSTOMER_SEGMENT 
ORDER BY CUSTOMER_ID;

SELECT GENDER, 
       ROUND(AVG(SPENDING_SCORE),2) AS AVERAGE_SPENDING_SCORE   
FROM CUSTOMER_SEGMENT 
GROUP BY GENDER 
ORDER BY GENDER; 

SELECT CUSTOMER_ID, 
       NAME, 
       GENDER, 
       SPENDING_SCORE 
FROM CUSTOMER_SEGMENT 
WHERE SPENDING_SCORE >= 75 
ORDER BY SPENDING_SCORE DESC;

SELECT CASE 
         WHEN ANNUAL_INCOME < 40000 THEN 'Low' 
         WHEN ANNUAL_INCOME BETWEEN 40000 AND 70000 THEN 'Medium' 
         ELSE 'High' 
       END AS INCOME_GROUP, 
       COUNT(*) AS CUSTOMER_COUNT 
FROM CUSTOMER_SEGMENT 
GROUP BY CASE 
           WHEN ANNUAL_INCOME < 40000 THEN 'Low' 
           WHEN ANNUAL_INCOME BETWEEN 40000 AND 70000 THEN 'Medium' 
           ELSE 'High'  
         END 
ORDER BY INCOME_GROUP;

SELECT GENDER, 
       ROUND(AVG(AGE),2) AS AVERAGE_AGE, 
       ROUND(AVG(SPENDING_SCORE),2) AS AVERAGE_SPENDING_SCORE 
FROM CUSTOMER_SEGMENT 
GROUP BY GENDER 
ORDER BY GENDER;
