CREATE TABLE CUSTOMER_SEGMENT ( 
    CUSTOMER_ID NUMBER PRIMARY KEY, 
    NAME VARCHAR2(50) NOT NULL, 
    AGE NUMBER NOT NULL, 
    GENDER VARCHAR2(10) NOT NULL, 
    ANNUAL_INCOME NUMBER NOT NULL, 
    SPENDING_SCORE NUMBER NOT NULL 
); 
