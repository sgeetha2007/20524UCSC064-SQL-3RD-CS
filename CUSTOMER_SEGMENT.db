SELECT * 
FROM CUSTOMER_SEGMENT 
ORDER BY CUSTOMER_ID;

SELECT GENDER, 
       ROUND(AVG(SPENDING_SCORE),2) AS AVERAGE_SPENDING_SCORE   
FROM CUSTOMER_SEGMENT 
GROUP BY GENDER 
ORDER BY GENDER; 

SELECT CUSTOMER_ID, 
       NAME, 
       GENDER, 
       SPENDING_SCORE 
FROM CUSTOMER_SEGMENT 
WHERE SPENDING_SCORE >= 75 
ORDER BY SPENDING_SCORE DESC;

SELECT CASE 
         WHEN ANNUAL_INCOME < 40000 THEN 'Low' 
         WHEN ANNUAL_INCOME BETWEEN 40000 AND 70000 THEN 'Medium' 
         ELSE 'High' 
       END AS INCOME_GROUP, 
       COUNT(*) AS CUSTOMER_COUNT 
FROM CUSTOMER_SEGMENT 
GROUP BY CASE 
           WHEN ANNUAL_INCOME < 40000 THEN 'Low' 
           WHEN ANNUAL_INCOME BETWEEN 40000 AND 70000 THEN 'Medium' 
           ELSE 'High'  
         END 
ORDER BY INCOME_GROUP;

SELECT GENDER, 
       ROUND(AVG(AGE),2) AS AVERAGE_AGE, 
       ROUND(AVG(SPENDING_SCORE),2) AS AVERAGE_SPENDING_SCORE 
FROM CUSTOMER_SEGMENT 
GROUP BY GENDER 
ORDER BY GENDER;

CREATE OR REPLACE FUNCTION CLASSIFY_CUSTOMER (   
 P_INCOME NUMBER,   
 P_SCORE NUMBER
) 
RETURN VARCHAR2 
IS
BEGIN
    IF P_INCOME >= 70000 AND P_SCORE >= 70 THEN 
        RETURN 'Premium Customer'; 
    ELSIF P_INCOME >= 40000 AND P_SCORE >= 50 THEN 
        RETURN 'Regular Customer'; 
    ELSE 
        RETURN 'Basic Customer'; 
    END IF; 
 
END; 
/

CREATE OR REPLACE PROCEDURE DISPLAY_SPENDING_CATEGORY ( 
    P_CATEGORY VARCHAR2 
) 
IS 
BEGIN 
    FOR R IN ( 
        SELECT CUSTOMER_ID, NAME, SPENDING_SCORE 
        FROM CUSTOMER_SEGMENT 
        WHERE 
            (P_CATEGORY = 'HIGH' AND SPENDING_SCORE >= 75) 
            OR 
            (P_CATEGORY = 'MEDIUM' AND SPENDING_SCORE BETWEEN 50 AND 74) 
 
            OR 
            (P_CATEGORY = 'LOW' AND SPENDING_SCORE < 50) 
    ) 
    LOOP 
        DBMS_OUTPUT.PUT_LINE( 
            R.CUSTOMER_ID || '  ' || 
            R.NAME || '  ' || 
            R.SPENDING_SCORE 
        ); 
    END LOOP; 
END; 
/

Execution: 
BEGIN 
    DISPLAY_SPENDING_CATEGORY('HIGH'); 
END; 
/ 

CREATE OR REPLACE PROCEDURE CUSTOMER_SUMMARY ( 
    P_CUSTOMER_ID NUMBER 
) 
IS 
    V_NAME CUSTOMER_SEGMENT.NAME%TYPE; 
    V_INCOME CUSTOMER_SEGMENT.ANNUAL_INCOME%TYPE; 
    V_SCORE CUSTOMER_SEGMENT.SPENDING_SCORE%TYPE; 
BEGIN 
    SELECT NAME, ANNUAL_INCOME, SPENDING_SCORE 
    INTO V_NAME, V_INCOME, V_SCORE 
    FROM CUSTOMER_SEGMENT 
    WHERE CUSTOMER_ID = P_CUSTOMER_ID; 
 
    DBMS_OUTPUT.PUT_LINE('Customer Name: ' || V_NAME); 
    DBMS_OUTPUT.PUT_LINE('Annual Income: ' || V_INCOME); 
    DBMS_OUTPUT.PUT_LINE('Spending Score: ' || V_SCORE); 
 
EXCEPTION 
    WHEN NO_DATA_FOUND THEN 
        DBMS_OUTPUT.PUT_LINE('Invalid Customer ID'); 
END; 
/

Exception: 
BEGIN 
    CUSTOMER_SUMMARY(5); 
END; 
/ 


